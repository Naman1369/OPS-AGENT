# Normalise text files to LF in the repository, checkout native on Windows.
* text=auto

# Explicit types
*.py    text diff=python
*.md    text
*.html  text
*.toml  text
*.txt   text
*.yml   text
*.yaml  text
*.json  text
*.jsonl text
*.csv   text
Dockerfile text

# Binary -- never diff or normalise
*.pdf   binary
*.png   binary
*.jpg   binary
*.docx  binary
*.faiss binary
