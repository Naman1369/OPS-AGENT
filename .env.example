# ---- OPS-AGENT environment ----
# Copy to .env and fill in. .env is git-ignored.

# LLM provider selection: mock | gemini | ollama
# Leave unset to auto-select: gemini if GEMINI_API_KEY is present, else mock.
OPS_LLM_PROVIDER=mock

# Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (deterministic local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Retrieval
OPS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPS_CHROMA_DIR=data/chroma
OPS_KB_DIR=data/knowledge_base
OPS_COLLECTION_NAME=ops_agent_kb
OPS_RETRIEVAL_TOP_K=4
# Minimum similarity for a document to count as usable grounding evidence.
OPS_MIN_RELEVANCE=0.25

# Governance (Week 5-7: RAW confidence only -- no calibration yet)
OPS_CONFIDENCE_THRESHOLD=0.70
OPS_MIN_CITATIONS=1
