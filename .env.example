# ---- OPS-AGENT environment ----
# Copy to .env and fill in. .env is git-ignored.

# LLM provider selection: mock | gemini | ollama
# Leave unset to auto-select: gemini if GEMINI_API_KEY is present, else mock.
OPS_LLM_PROVIDER=mock

# Gemini (primary) - current Google Gen AI SDK (pip install google-genai).
# gemini-1.5-* models are retired; any current model ID works here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Minimal thinking keeps JSON answers short and runs reproducible:
# budget 0 disables thinking on Gemini 2.5 Flash; Gemini 3.x uses a level.
OPS_GEMINI_THINKING_BUDGET=0
OPS_GEMINI_THINKING_LEVEL=low

# Ollama (deterministic local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Retrieval
# OPS_EMBEDDER: auto (MiniLM, else TF-IDF) | minilm | tfidf
OPS_EMBEDDER=auto
OPS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional local copy of the embedding model for air-gapped machines:
OPS_EMBEDDING_MODEL_PATH=
OPS_CHROMA_DIR=data/chroma
OPS_KB_DIR=data/knowledge_base
OPS_COLLECTION_NAME=ops_agent_kb
OPS_RETRIEVAL_TOP_K=4
# Minimum similarity for a document to count as usable grounding evidence.
OPS_MIN_RELEVANCE=0.25

# Governance
# auto: calibrated when a profile in OPS_CALIBRATION_PATH matches the running
# configuration (provider, model, embedder, prompts, knowledge base); raw otherwise.
OPS_GOVERNANCE_MODE=auto
OPS_CALIBRATION_PATH=artifacts/calibration
# Risk target used when fitting a profile (scripts/calibrate.py):
# at most alpha of all tickets resolved autonomously AND unsafely, w.p. >= 1 - delta.
OPS_RISK_ALPHA=0.05
OPS_RISK_DELTA=0.10
# Naive raw-confidence threshold - raw mode / the naively-governed baseline only.
OPS_CONFIDENCE_THRESHOLD=0.70
OPS_MIN_CITATIONS=1

# Audit trail (append-only, hash-chained SQLite)
OPS_AUDIT_ENABLED=true
OPS_AUDIT_DB=data/audit/audit.sqlite3
